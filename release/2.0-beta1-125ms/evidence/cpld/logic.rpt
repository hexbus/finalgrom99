	slot_enable/slot_enable_D2));

FDCPE_slot1: FDCPE port map (slot(1),slot_D(1),slot(6)/slot(6)_CLKF,'0','0');
slot_D(1) <= ((slot(1) AND NOT slot_enable/slot_enable_D2)
	OR (NOT offline AND RAM_DX(1).PIN AND 
	slot_enable/slot_enable_D2)
	OR (NOT giga AND offline AND NOT CDX(7).PIN AND CDX(1).PIN AND 
	slot_enable/slot_enable_D2));

FDCPE_slot2: FDCPE port map (slot(2),slot_D(2),slot(6)/slot(6)_CLKF,'0','0');
slot_D(2) <= ((slot(2) AND NOT slot_enable/slot_enable_D2)
	OR (NOT offline AND RAM_DX(2).PIN AND 
	slot_enable/slot_enable_D2)
	OR (CDX(2).PIN AND NOT giga AND offline AND NOT CDX(7).PIN AND 
	slot_enable/slot_enable_D2));

FDCPE_slot3: FDCPE port map (slot(3),slot_D(3),slot(6)/slot(6)_CLKF,'0','0');
slot_D(3) <= ((slot(3) AND NOT slot_enable/slot_enable_D2)
	OR (RAM_DX(3).PIN AND NOT offline AND 
	slot_enable/slot_enable_D2)
	OR (NOT giga AND offline AND NOT CDX(7).PIN AND CDX(3).PIN AND 
	slot_enable/slot_enable_D2));

FDCPE_slot4: FDCPE port map (slot(4),slot_D(4),slot(6)/slot(6)_CLKF,'0','0');
slot_D(4) <= ((slot(4) AND NOT slot_enable/slot_enable_D2)
	OR (RAM_DX(4).PIN AND NOT offline AND 
	slot_enable/slot_enable_D2)
	OR (NOT giga AND offline AND NOT CDX(7).PIN AND CDX(4).PIN AND 
	slot_enable/slot_enable_D2));

FDCPE_slot5: FDCPE port map (slot(5),slot_D(5),slot(6)/slot(6)_CLKF,'0','0');
slot_D(5) <= ((slot(5) AND NOT slot_enable/slot_enable_D2)
	OR (RAM_DX(5).PIN AND NOT offline AND 
	slot_enable/slot_enable_D2)
	OR (NOT giga AND offline AND NOT CDX(7).PIN AND CDX(5).PIN AND 
	slot_enable/slot_enable_D2));


slot(6)/slot(6)_CLKF <= ((CCLK AND offline)
	OR (WE AND NOT offline));

FDCPE_slot6: FDCPE port map (slot(6),slot_D(6),slot(6)/slot(6)_CLKF,'0','0');
slot_D(6) <= ((slot(6) AND NOT slot_enable/slot_enable_D2)
	OR (RAM_DX(6).PIN AND NOT offline AND 
	slot_enable/slot_enable_D2)
	OR (NOT giga AND offline AND NOT CDX(7).PIN AND CDX(6).PIN AND 
	slot_enable/slot_enable_D2));


slot_enable/slot_enable_D2 <= ((CCMD(2) AND offline AND NOT CCMD(1) AND NOT CCMD(0))
	OR (select_armed AND giga AND NOT offline AND NOT BUS_AX(0) AND 
	NOT ROMS));

FDCPE_valid: FDCPE port map (valid,valid_D,WE,'0',valid_PRE,valid_CE);
valid_D <= ((NOT RAM_DX(7).PIN)
	OR (RAM_DX(3).PIN AND RAM_DX(4).PIN AND RAM_DX(5).PIN AND 
	RAM_DX(6).PIN AND RAM_DX(2).PIN AND RAM_DX(0).PIN)
	OR (RAM_DX(3).PIN AND RAM_DX(4).PIN AND RAM_DX(5).PIN AND 
	RAM_DX(6).PIN AND RAM_DX(2).PIN AND RAM_DX(1).PIN));
valid_PRE <= (CCMD(2) AND offline AND NOT CCMD(1) AND NOT CCMD(0));
valid_CE <= (select_armed AND giga AND NOT offline AND NOT BUS_AX(0) AND 
	NOT ROMS);

